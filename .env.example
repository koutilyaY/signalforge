# Copy to .env and adjust. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#   # then generate a real JWT secret:
#   openssl rand -base64 48
#
# The default ports below are deliberately offset from the usual defaults
# (5432/6379/9092/9090/3000/8080) so this stack can coexist with other local
# projects. Change them freely if they clash on your machine.

# ---- Ports (host side) ----
POSTGRES_PORT=5442
REDIS_PORT=6389
KAFKA_PORT=19092
BACKEND_PORT=8099
FRONTEND_PORT=3010
PROMETHEUS_PORT=9099
GRAFANA_PORT=3011

# ---- Postgres ----
POSTGRES_USER=signalforge
POSTGRES_PASSWORD=signalforge
POSTGRES_DB=signalforge

# ---- Grafana ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ---- Security ----
# REQUIRED. Minimum 32 bytes of entropy; HS256 signing key for access tokens.
# The application refuses to start with a short or default-looking secret.
SF_JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Password for `signalforge_app`, the unprivileged role the application connects
# as. It is deliberately NOT the POSTGRES_USER above: row-level security exempts
# superusers and table owners unconditionally, so connecting as the owner would
# silently disable every policy in V4__row_level_security.sql. Flyway uses the
# owner credentials to migrate; the running application uses these.
SF_DB_APP_PASSWORD=signalforge_app

# ---- AI (optional) ----
# SignalForge is fully functional with SF_AI_ENABLED=false. Enabling it only
# adds a narrative summary on top of the deterministic correlation output.
# Requires a local Ollama: `ollama serve` then `ollama pull llama3.2:3b`.
SF_AI_ENABLED=false
SF_AI_BASE_URL=http://host.docker.internal:11434
SF_AI_MODEL=llama3.2:3b
